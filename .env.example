# HF-mirror: fresh installation. Keep this file free of real credentials.
# Optional: pin a published container version (for example, v0.1.0).
HF_MIRROR_VERSION=latest
BETTER_AUTH_SECRET=your-secret-key-change-this-in-production
BETTER_AUTH_URL=http://localhost:5321
PORT=5321
DATABASE_URL=file:data/hf-mirror.db

# Optional: configure these in the UI instead.
HF_USERNAME=
HF_TOKEN=
SOURCE_URL=https://huggingface.co
GITEA_URL=
GITEA_USERNAME=
GITEA_TOKEN=

# Complete historical file backups are on by default.
GITEA_LFS=true
MIRROR_METADATA=true
MIRROR_ISSUES=true
MIRROR_PULL_REQUESTS=true
PUSH_CONCURRENCY=2

# Scheduling is opt-in; the UI also supports schedules.
SCHEDULE_ENABLED=false
SCHEDULE_TIMEZONE=UTC
