{
  "name": "hf-mirror",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "bun": ">=1.2.9"
  },
  "scripts": {
    "setup": "bun install && bun run manage-db init",
    "dev": "bun x --bun astro dev",
    "dev:clean": "bun run cleanup-db && bun run manage-db init && bun x --bun astro dev",
    "build": "bun x --bun astro build",
    "cleanup-db": "rm -f hf-mirror.db data/hf-mirror.db",
    "manage-db": "bun scripts/manage-db.ts",
    "init-db": "bun scripts/manage-db.ts init",
    "check-db": "bun scripts/manage-db.ts check",
    "fix-db": "bun scripts/manage-db.ts fix",
    "reset-users": "bun scripts/manage-db.ts reset-users",
    "reset-password": "bun scripts/manage-db.ts reset-password",
    "db:generate": "bun drizzle-kit generate",
    "db:migrate": "bun drizzle-kit migrate",
    "db:push": "bun drizzle-kit push",
    "db:pull": "bun drizzle-kit pull",
    "db:check": "bun drizzle-kit check",
    "db:studio": "bun drizzle-kit studio",
    "startup-recovery": "bun scripts/startup-recovery.ts",
    "startup-recovery-force": "bun scripts/startup-recovery.ts --force",
    "startup-env-config": "bun scripts/startup-env-config.ts",
    "preview": "bun x --bun astro preview",
    "start": "bun scripts/runtime-server.ts",
    "start:fresh": "bun run cleanup-db && bun run manage-db init && bun scripts/runtime-server.ts",
    "test": "bun test",
    "test:migrations": "bun scripts/validate-migrations.ts",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:e2e": "bun tests/container-e2e/run.ts",
    "test:e2e:ci": "bun tests/container-e2e/run.ts",
    "test:e2e:keep": "bun tests/container-e2e/run.ts --keep",
    "astro": "bun x --bun astro",
    "test:hf": "bun test --timeout 30000 src/lib/source-providers/huggingface.test.ts src/lib/push-engine/targets/gitea-hf.test.ts src/lib/push-engine/hf-engine.test.ts src/lib/hf-metadata.test.ts src/lib/db/hf-migration.test.ts src/lib/push-engine/engine.test.ts src/lib/hf-identity.test.ts",
    "test:shared": "bun test --timeout 30000 src/lib/auth-guards.test.ts src/lib/auth-origins.test.ts src/lib/auth-signup-guard.test.ts src/lib/auth-api-key-guard.test.ts src/lib/utils/outbound-url.test.ts src/lib/utils/duration-parser.test.ts src/lib/utils/schedule-utils.test.ts src/lib/config-locks.test.ts src/lib/repo-identity.test.ts src/lib/db/reset-password-cli.test.ts src/tests/routes/api/sources src/tests/routes/api/config/source-url.test.ts src/tests/routes/api/sync/organization.test.ts"
  },
  "overrides": {
    "@esbuild-kit/esm-loader": "npm:tsx@^4.21.0",
    "@xmldom/xmldom": "^0.8.15",
    "browserslist": "^4.28.7",
    "devalue": "^5.9.2",
    "fast-uri": "^3.1.5",
    "fast-xml-builder": "^1.1.7",
    "js-yaml": "^4.3.2",
    "smol-toml": "^1.7.1",
    "kysely": "^0.28.17",
    "lodash": "^4.18.1",
    "picomatch": "^4.0.4",
    "sharp": "^0.35.4",
    "svgo": "^4.1.0"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.5",
    "@astrojs/react": "^6.0.1",
    "@better-auth/api-key": "1.7.2",
    "@better-auth/oauth-provider": "1.7.2",
    "@better-auth/sso": "1.7.2",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-radio-group": "^1.4.3",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.2.8",
    "better-auth": "1.7.2",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.24.0",
    "nanoid": "^6.0.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.1",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2",
    "playwright": "^1.61.1"
  },
  "packageManager": "bun@1.3.10"
}
